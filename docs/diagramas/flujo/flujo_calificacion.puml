@startuml Diagrama de Flujo - Calificación de Estudiantes

' Estilos
skinparam backgroundColor #FEFEFE
skinparam activity {
  BackgroundColor #E3F2FD
  BorderColor #1976D2
  DiamondBackgroundColor #FFF9C4
  DiamondBorderColor #F57C00
  StartColor #4CAF50
  EndColor #F44336
}

start

:Docente accede a\n/docente/:curso/calificar;

:Cargar lista de RAs del curso;
:Cargar lista de estudiantes matriculados;

:Seleccionar RA;

:Cargar actividades del RA;

:Seleccionar actividad;

if (¿Actividad tiene\nindicadores asignados?) then (Sí)
  :Cargar indicadores del RA;
  :Mostrar selector de indicadores;
else (No)
  :Calificación general de la actividad;
endif

:Seleccionar estudiante de la lista;

if (¿Estudiante ya tiene\nnota registrada?) then (Sí)
  :Cargar nota existente;
  :Mostrar en formulario para edición;
  note right
    Permite modificar nota
    y retroalimentación
  end note
else (No)
  :Inicializar formulario vacío;
endif

:Docente ingresa nota (0.0 - 5.0);

if (¿Nota es válida?) then (No)
  :Mostrar error de validación;
  stop
else (Sí)
  if (¿Agregar retroalimentación?) then (Sí)
    :Docente escribe retroalimentación;
  endif
  
  if (¿Seleccionar indicador\nespecífico?) then (Sí)
    :Seleccionar indicador de la lista;
    note right
      Permite calificar por
      indicador de logro específico
    end note
  endif
  
  :Click en "Guardar Calificación";
  
  :Validar permisos de docente;
  
  if (¿Docente autorizado\npara este curso?) then (No)
    :Mostrar error 403 Forbidden;
    stop
  else (Sí)
    :Validar matrícula del estudiante;
    
    if (¿Matrícula válida?) then (No)
      :Mostrar error "Matrícula no encontrada";
      stop
    else (Sí)
      
      partition "Transacción BD" {
        if (¿Ya existe nota para\n(matrícula, ra_actividad, indicador)?) then (Sí)
          :UPDATE notas_actividad;
          note right
            Actualiza nota existente
            manteniendo historial
          end note
        else (No)
          :INSERT INTO notas_actividad;
          note right
            Crea nueva calificación
          end note
        endif
        
        :Commit transacción;
      }
      
      :Agregar notificación\npara estudiante;
      note right
        Notificación en caché:
        "Nueva calificación disponible
        en [nombre_actividad]"
      end note
      
      :Calcular promedios actualizados;
      
      partition "Cálculo de Promedios" {
        :Para cada RA:\nCalcular nota progresiva;
        note right
          Promedio ponderado de
          actividades calificadas
        end note
        
        :Para cada RA:\nCalcular cobertura;
        note right
          % de actividades calificadas
          sobre total de actividades
        end note
        
        :Calcular promedio del curso;
        note right
          Nota progresiva:
          Promedio de RAs ponderado
          por % de cada RA
          
          Nota estricta:
          Considera solo lo calificado
          sobre el total del curso
        end note
      }
      
      :Retornar respuesta exitosa;
      
      :Actualizar interfaz con nueva nota;
      
      :Mostrar mensaje "Calificación guardada";
      
      :Actualizar tabla de resumen;
      
    endif
  endif
endif

if (¿Calificar otro estudiante?) then (Sí)
  :Ir a siguiente estudiante;
  backward :Formulario nuevo;
else (No)
  if (¿Calificar otra actividad?) then (Sí)
    backward :Seleccionar actividad;
  else (No)
    stop
  endif
endif

@enduml
