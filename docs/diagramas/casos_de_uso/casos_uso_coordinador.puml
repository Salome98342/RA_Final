@startuml Casos de Uso - Coordinador

' Estilos
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam backgroundColor #FEFEFE
skinparam actorBackgroundColor #FFEBEE
skinparam actorBorderColor #F44336
skinparam usecaseBackgroundColor #FFF9C4
skinparam usecaseBorderColor #F57C00

left to right direction

' Actor
actor "Coordinador" as coordinador #LightSalmon




package "Visualización de Dashboard" {
  usecase (Ver Dashboard General) as UC40
  usecase (Ver Estadísticas Globales) as UC40A
  usecase (Ver Métricas por Periodo) as UC40B
  usecase (Ver Todas las Asignaturas) as UC41
  usecase (Aplicar Paginación) as UC41A
}

package "Gestión de Asignaturas" {
  usecase (Filtrar Asignaturas) as UC42
  usecase (Filtrar por Programa) as UC42A
  usecase (Filtrar por Docente) as UC42B
  usecase (Filtrar por Periodo) as UC42C
  usecase (Ver Detalles de Asignatura) as UC43
  usecase (Ver RAs de Asignatura) as UC44
  usecase (Ver Actividades por RA) as UC44A
  usecase (Ver Indicadores por RA) as UC44B
  usecase (Ver Estudiantes por Asignatura) as UC45
  usecase (Filtrar Estudiantes por Periodo) as UC45A
  usecase (Ver Avance por Asignatura) as UC46
  usecase (Ver Promedios por RA) as UC46A
  usecase (Ver Cobertura Global) as UC46B
  usecase (Ver Estudiantes en Riesgo) as UC46C
}

package "Importación Masiva de Datos" {
  usecase (Importar Matriculados) as UC50
  usecase (Descargar Plantilla CSV) as UC50A
  usecase (Validar Archivo CSV) as UC50B
  usecase (Procesar Matriculaciones) as UC50C
  usecase (Ver Reporte de Importación) as UC50D
  
  usecase (Importar Docentes) as UC51
  usecase (Validar Datos de Docentes) as UC51A
  usecase (Generar Contraseñas) as UC51B
  usecase (Crear Cuentas de Docentes) as UC51C
  
  usecase (Importar Asignaturas y RAs) as UC52
  usecase (Validar Estructura de Asignaturas) as UC52A
  usecase (Procesar RAs e Indicadores) as UC52B
  usecase (Asignar Docentes a Asignaturas) as UC52C
}

package "Gestión de Programas Académicos" {
  usecase (Ver Programas) as UC60
  usecase (Crear Programa) as UC61
  usecase (Editar Programa) as UC62
  usecase (Ver Asignaturas por Programa) as UC63
}

package "Gestión de Periodos Académicos" {
  usecase (Ver Periodos Académicos) as UC70
  usecase (Crear Periodo Académico) as UC71
  usecase (Establecer Fechas) as UC71A
  usecase (Editar Periodo Académico) as UC72
  usecase (Ver Matriculaciones por Periodo) as UC73
}

package "Auditoría y Reportes" {
  usecase (Ver Historial de Importaciones) as UC80
  usecase (Ver Detalles de Auditoría) as UC80A
  usecase (Filtrar por Tipo de Importación) as UC80B
  usecase (Exportar Reportes) as UC81
  usecase (Generar Reporte de Asignatura) as UC81A
  usecase (Generar Reporte de Programa) as UC81B
}

package "Vista de Docente (Acceso Completo)" {
  usecase (Acceder como Docente) as UC90
  usecase (Ver Cursos como Docente) as UC91
  usecase (Calificar en Cualquier Curso) as UC92
}

