@startuml Casos de Uso - RA Manager

' Estilos
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam backgroundColor #FEFEFE
skinparam actorBackgroundColor #E1F5FE
skinparam actorBorderColor #0288D1
skinparam usecaseBackgroundColor #FFF9C4
skinparam usecaseBorderColor #F57C00

left to right direction

' Actores
actor "Estudiante" as estudiante #LightBlue
actor "Docente" as docente #LightGreen
actor "Coordinador" as coordinador #LightSalmon
actor "Sistema de Email" as email #LightGray

' Paquetes de casos de uso
package "Gestión de Autenticación" {
  usecase (Iniciar Sesión) as UC1
  usecase (Recuperar Contraseña) as UC2
  usecase (Verificar OTP) as UC3
  usecase (Restablecer Contraseña) as UC4
  usecase (Cerrar Sesión) as UC5
  usecase (Cambiar Contraseña) as UC6
}

package "Gestión de Perfil" {
  usecase (Ver Perfil) as UC7
  usecase (Editar Perfil) as UC8
  usecase (Subir Avatar) as UC9
}

package "Gestión de Cursos - Estudiante" {
  usecase (Ver Mis Cursos) as UC10
  usecase (Ver Resultados de Aprendizaje) as UC11
  usecase (Ver Mis Calificaciones) as UC12
  usecase (Ver Actividades Agrupadas) as UC13
  usecase (Ver Resumen de Notas) as UC14
  usecase (Ver Recursos del Curso) as UC15
  usecase (Descargar Recursos) as UC16
  usecase (Ver Notificaciones) as UC17
}

package "Gestión de Cursos - Docente" {
  usecase (Ver Cursos Asignados) as UC20
  usecase (Gestionar RAs del Curso) as UC21
  usecase (Crear Actividad) as UC22
  usecase (Asignar Indicadores a Actividad) as UC23
  usecase (Calificar Estudiantes) as UC24
  usecase (Registrar Notas por Indicador) as UC25
  usecase (Dar Retroalimentación) as UC26
  usecase (Subir Recursos) as UC27
  usecase (Eliminar Recursos) as UC28
  usecase (Ver Estadísticas del Curso) as UC29
  usecase (Importar Estudiantes CSV) as UC30
}

package "Gestión Administrativa - Coordinador" {
  usecase (Ver Dashboard) as UC40
  usecase (Ver Todas las Asignaturas) as UC41
  usecase (Filtrar Asignaturas) as UC42
  usecase (Ver Detalles de Asignatura) as UC43
  usecase (Ver RAs de Asignatura) as UC44
  usecase (Ver Estudiantes por Asignatura) as UC45
  usecase (Ver Avance por Asignatura) as UC46
  usecase (Importar Matriculados) as UC47
  usecase (Importar Docentes) as UC48
  usecase (Importar Asignaturas y RAs) as UC49
  usecase (Gestionar Programas) as UC50
  usecase (Gestionar Periodos Académicos) as UC51
}

' Relaciones Estudiante
estudiante --> UC1
estudiante --> UC2
estudiante --> UC5
estudiante --> UC6
estudiante --> UC7
estudiante --> UC8
estudiante --> UC9
estudiante --> UC10
estudiante --> UC11
estudiante --> UC12
estudiante --> UC13
estudiante --> UC14
estudiante --> UC15
estudiante --> UC16
estudiante --> UC17

' Relaciones Docente
docente --> UC1
docente --> UC2
docente --> UC5
docente --> UC6
docente --> UC7
docente --> UC8
docente --> UC9
docente --> UC20
docente --> UC21
docente --> UC22
docente --> UC23
docente --> UC24
docente --> UC25
docente --> UC26
docente --> UC27
docente --> UC28
docente --> UC29
docente --> UC30

' Relaciones Coordinador
coordinador --> UC1
coordinador --> UC2
coordinador --> UC5
coordinador --> UC6
coordinador --> UC7
coordinador --> UC8
coordinador --> UC9
coordinador --> UC40
coordinador --> UC41
coordinador --> UC42
coordinador --> UC43
coordinador --> UC44
coordinador --> UC45
coordinador --> UC46
coordinador --> UC47
coordinador --> UC48
coordinador --> UC49
coordinador --> UC50
coordinador --> UC51

' Relaciones con Sistema Email
UC2 ..> UC3 : <<include>>
UC3 --> email : envía OTP
UC3 ..> UC4 : <<include>>

' Relaciones de extensión e inclusión
UC12 ..> UC14 : <<include>>
UC13 ..> UC11 : <<include>>
UC22 ..> UC23 : <<extend>>
UC24 ..> UC25 : <<include>>
UC24 ..> UC26 : <<extend>>
UC41 ..> UC42 : <<extend>>
UC43 ..> UC44 : <<include>>
UC43 ..> UC45 : <<include>>
UC43 ..> UC46 : <<include>>

note right of UC25
  Permite calificar por 
  indicador de logro específico
end note

note right of UC13
  Agrupa actividades por RA
  mostrando notas y retroalimentación
end note

note right of UC14
  Muestra nota progresiva,
  nota estricta y cobertura
end note

note bottom of UC47
  Importa masivamente desde
  CSV con validaciones
end note

@enduml
