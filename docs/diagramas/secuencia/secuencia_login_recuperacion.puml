@startuml Diagrama de Secuencia - Login y Recuperación de Contraseña

' Estilos
skinparam backgroundColor #FEFEFE
skinparam sequenceMessageAlign center

actor "Usuario" as user
participant "Login\n(React)" as login_ui
participant "Recuperar\n(React)" as recuperar_ui
participant "Reset\n(React)" as reset_ui
participant "auth.ts" as auth
participant "HTTP Client" as http
participant "views.py" as views
participant "models.py" as models
database "PostgreSQL" as db
participant "Gmail SMTP" as email

== Flujo de Login Exitoso ==

user -> login_ui : Ingresa código/email y contraseña
activate login_ui
user -> login_ui : Selecciona rol (docente/estudiante/coordinador)
user -> login_ui : Click en "Iniciar Sesión"

login_ui -> auth : login(code, password)
activate auth
auth -> http : POST /api/auth/login/
activate http
note right
  Payload:
  {
    "codigo": "D001",
    "password": "****",
    "rol": "docente"
  }
end note

http -> views : login_view(request)
activate views

views -> views : _normalize_login_payload(data)
note right
  Normaliza campos de entrada:
  - email/correo
  - codigo/code
  - password/contrasena
end note

alt Buscar por rol específico
  
  alt Rol = docente
    views -> models : Docente.objects.filter()
    activate models
    models -> db : SELECT * FROM docente
    activate db
    db --> models : Docente encontrado
    deactivate db
    models --> views : Docente instance
    deactivate models
  end
  
  alt Rol = estudiante
    views -> models : Estudiante.objects.filter()
    activate models
    models -> db : SELECT * FROM estudiante
    activate db
    db --> models : Estudiante encontrado
    deactivate db
    models --> views : Estudiante instance
    deactivate models
  end
  
  alt Rol = coordinador
    views -> models : Coordinador.objects.filter()
    activate models
    models -> db : SELECT * FROM coordinador
    activate db
    db --> models : Coordinador encontrado
    deactivate db
    models --> views : Coordinador instance
    deactivate models
  end
  
end

views -> views : check_password(password, hash)
note right
  Verifica contraseña usando
  Django's password hasher
end note

alt Credenciales válidas
  views -> views : signing.dumps({"rol": rol, "id": id})
  note right
    Genera JWT token firmado
    con max_age de 7 días
  end note
  
  views --> http : Response({"token": token, "user": {...}})
  
else Credenciales inválidas
  views --> http : Response({"detail": "Credenciales inválidas"}, 401)
end

deactivate views
http --> auth : {token, user}
deactivate http

auth -> auth : setAuthToken(token)
note right
  Guarda token en:
  - sessionStorage (pestaña actual)
  - localStorage (persistencia)
end note

auth --> login_ui : UserProfile
deactivate auth

login_ui -> login_ui : SessionContext.dispatch(LOGIN)
note right
  Actualiza estado global con:
  - id, rol, nombre, code
end note

login_ui --> user : Redirige a dashboard según rol
deactivate login_ui

== Flujo de Recuperación de Contraseña ==

user -> recuperar_ui : Ingresa email
activate recuperar_ui
user -> recuperar_ui : Click en "Enviar código"

recuperar_ui -> auth : requestPasswordReset(email)
activate auth
auth -> http : POST /api/auth/forgot/
activate http
note right
  Payload:
  {
    "email": "usuario@correo.com"
  }
end note

http -> views : password_forgot_view(request)
activate views

views -> models : Buscar usuario por email en todas las tablas
activate models
models -> db : SELECT * FROM docente WHERE correo=:email
activate db
db --> models : Docente/Estudiante/Coordinador
deactivate db
models --> views : Usuario y rol
deactivate models

alt Usuario encontrado
  
  views -> views : Generar OTP (6 dígitos)
  note right
    otp_code = random.randint(100000, 999999)
  end note
  
  views -> views : Calcular expires_at (10 minutos)
  
  views -> models : PasswordResetOTP.objects.create()
  activate models
  models -> db : INSERT INTO password_reset_otp
  activate db
  db --> models : OTP guardado
  deactivate db
  models --> views : OTP instance
  deactivate models
  
  views -> email : send_mail(subject, message, to)
  activate email
  note right
    Asunto: "Código de recuperación"
    Mensaje: "Tu código es: 123456"
    Configuración Gmail SMTP
  end note
  email --> views : Email enviado
  deactivate email
  
  views --> http : Response({"message": "OTP enviado"})
  
else Usuario no encontrado
  views --> http : Response({"detail": "Email no encontrado"}, 404)
end

deactivate views
http --> auth : Success
deactivate http
auth --> recuperar_ui : Success
deactivate auth

recuperar_ui --> user : Muestra mensaje "Código enviado"
deactivate recuperar_ui

== Verificación y Reset de Contraseña ==

user -> reset_ui : Ingresa email, OTP y nueva contraseña
activate reset_ui
user -> reset_ui : Click en "Restablecer"

reset_ui -> auth : verifyOTP(email, otp)
activate auth
auth -> http : POST /api/auth/verify-otp/
activate http
http -> views : verify_otp_view(request)
activate views

views -> models : PasswordResetOTP.objects.filter()
activate models
models -> db : SELECT * FROM password_reset_otp\nWHERE email=:email AND otp_code=:code
activate db
db --> models : OTP encontrado
deactivate db
models --> views : OTP instance
deactivate models

views -> views : otp.is_valid()
note right
  Verifica:
  - not is_used
  - expires_at > now()
end note

alt OTP válido
  views --> http : Response({"valid": true})
else OTP inválido/expirado
  views --> http : Response({"detail": "OTP inválido"}, 400)
end

deactivate views
http --> auth : Success
deactivate http
auth --> reset_ui : Verified
deactivate auth

reset_ui -> auth : resetPassword(email, otp, newPassword)
activate auth
auth -> http : POST /api/auth/reset/
activate http
http -> views : password_reset_view(request)
activate views

views -> models : PasswordResetOTP.objects.filter()
activate models
models -> db : SELECT * FROM password_reset_otp
activate db
db --> models : OTP válido
deactivate db
models --> views : OTP instance
deactivate models

alt OTP válido y no usado

  views -> views : make_password(new_password)
  note right
    Hash de contraseña con
    Django PBKDF2 algorithm
  end note
  
  views -> models : Usuario.objects.filter(correo=email).update()
  activate models
  models -> db : UPDATE [docente/estudiante/coordinador]\nSET contrasenia=:hash
  activate db
  db --> models : Contraseña actualizada
  deactivate db
  models --> views : Updated
  deactivate models
  
  views -> models : otp.is_used = True; otp.save()
  activate models
  models -> db : UPDATE password_reset_otp SET is_used=true
  activate db
  db --> models : OTP marcado como usado
  deactivate db
  models --> views : Saved
  deactivate models
  
  views --> http : Response({"message": "Contraseña actualizada"})
  
else OTP inválido/usado
  views --> http : Response({"detail": "OTP inválido"}, 400)
end

deactivate views
http --> auth : Success
deactivate http
auth --> reset_ui : Password reset successful
deactivate auth

reset_ui --> user : Muestra éxito y redirige a login
deactivate reset_ui

@enduml
