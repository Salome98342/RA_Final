@startuml Diagrama de Secuencia - Docente: Gestión de Recursos

' Estilos
skinparam backgroundColor #FEFEFE
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor "Docente" as docente
participant "Recursos\n(React)" as ui
participant "api.ts" as api
participant "HTTP Client" as http
participant "views.py" as views
participant "models.py" as models
database "PostgreSQL" as db
participant "FileSystem" as fs

== Ver Lista de Recursos del Curso ==

docente -> ui : Navega a /docente/recursos/:curso
activate ui

ui -> api : getCourse(cursoId)
activate api
api -> http : GET /api/asignaturas/:codigo/
activate http
http -> views : asignatura_detail_view()
activate views
views -> models : Asignatura.objects.get(codigo=codigo)
activate models
models -> db : SELECT FROM asignatura
activate db
db --> models : Asignatura
deactivate db
models --> views : Asignatura
deactivate models
views --> http : Response(asignatura)
deactivate views
http --> api : Course
deactivate http
api --> ui : Datos del curso
deactivate api

ui -> api : getRecursosByCourse(cursoId)
activate api
api -> http : GET /api/asignaturas/:codigo/recursos/
activate http
http -> views : asignatura_recursos_view()
activate views
views -> models : Recurso.objects.filter(asignatura=asig)
activate models
models -> db : SELECT * FROM recurso\nWHERE codigo_asignatura = :codigo\nORDER BY fecha_subida DESC
activate db
db --> models : Lista de recursos
deactivate db
models --> views : QuerySet
deactivate models
views --> http : Response([...])
deactivate views
http --> api : Recurso[]
deactivate http
api --> ui : Lista de recursos
deactivate api

ui --> docente : Muestra tabla de recursos:
note right
  **Columnas:**
  - Nombre del archivo
  - Fecha de subida
  - Tamaño del archivo
  - Acciones (Descargar, Eliminar)
  
  **Botón:** [+ Subir Nuevo Recurso]
end note
deactivate ui

== Subir Nuevo Recurso ==

docente -> ui : Click en "Subir Nuevo Recurso"
activate ui

ui --> docente : Muestra modal con formulario:
note right
  - Input de título (opcional)
  - File input (aceptar: .pdf, .docx, 
    .pptx, .xlsx, .zip, imágenes)
  - Límite: 10MB por archivo
  - Botón: [Subir]
end note

docente -> ui : Selecciona archivo y envía
ui -> ui : Validar archivo localmente
note right
  Validaciones:
  - Extensión permitida
  - Tamaño <= 10MB
  - Archivo no vacío
end note

alt Validación local falla
  ui --> docente : Mostrar error en modal
else Validación local exitosa
  
  ui -> api : uploadRecurso(cursoId, formData)
  activate api
  note left of api
    formData = new FormData()
    formData.append('archivo', file)
    formData.append('titulo', titulo || file.name)
    formData.append('codigo_asignatura', cursoId)
  end note
  
  api -> http : POST /api/recursos/\nContent-Type: multipart/form-data
  activate http
  http -> views : recurso_upload_view()
  activate views
  
  views -> views : Validar archivo en backend
  note right
    Validaciones:
    1. Asignatura existe
    2. Docente imparte la asignatura
    3. Extensión permitida
    4. Tamaño <= 10MB
    5. Archivo no es malicioso
  end note
  
  alt Validación backend falla
    views --> http : Response 400 (BadRequest)
    deactivate views
    http --> api : Error
    deactivate http
    api --> ui : Error message
    deactivate api
    ui --> docente : Mostrar error en modal
  else Validación backend exitosa
    
    views -> fs : Guardar archivo en /media/recursos/
    activate fs
    note right
      Estructura:
      /media/recursos/
        /<codigo_asignatura>/
          /<timestamp>_<filename>
      
      Ejemplo:
      /media/recursos/MAT101/
        /1234567890_apuntes.pdf
    end note
    fs --> views : Ruta del archivo guardado
    deactivate fs
    
    views -> models : Recurso.objects.create()
    activate models
    models -> db : INSERT INTO recurso\n(titulo, archivo, codigo_asignatura,\n fecha_subida)
    activate db
    db --> models : recurso_id
    deactivate db
    models --> views : Recurso creado
    deactivate models
    
    views -> views : Crear notificación para estudiantes
    note right
      Sistema de notificaciones:
      - Obtener estudiantes matriculados
      - Agregar notificación a _NOTIFICATIONS_CACHE
      - Tipo: 'recurso_nuevo'
    end note
    
    views --> http : Response 201 (Created)
    deactivate views
    http --> api : Recurso
    deactivate http
    api --> ui : Recurso creado
    deactivate api
    
    ui -> ui : Cerrar modal
    ui -> ui : Agregar recurso a la lista
    ui --> docente : Mostrar mensaje: "Recurso subido exitosamente"
  end
end

deactivate ui

== Descargar Recurso ==

docente -> ui : Click en "Descargar" de un recurso
activate ui

ui -> http : GET /media/recursos/:path
activate http
http -> fs : Leer archivo
activate fs
fs --> http : Archivo binario
deactivate fs
http --> ui : Archivo
deactivate http

ui --> docente : Descarga iniciada
deactivate ui

== Eliminar Recurso ==

docente -> ui : Click en "Eliminar" de un recurso
activate ui

ui --> docente : Mostrar diálogo de confirmación:
note right
  "¿Estás seguro de eliminar este recurso?
  Los estudiantes ya no podrán descargarlo."
  
  [Cancelar] [Eliminar]
end note

docente -> ui : Confirma eliminación
ui -> api : deleteRecurso(recursoId)
activate api
api -> http : DELETE /api/recursos/:id/
activate http
http -> views : recurso_delete_view()
activate views

views -> models : Recurso.objects.get(id=id)
activate models
models -> db : SELECT FROM recurso WHERE id = :id
activate db
db --> models : Recurso
deactivate db
models --> views : Recurso
deactivate models

views -> views : Verificar permisos
note right
  Validaciones:
  - Docente imparte la asignatura del recurso
  - Recurso existe
end note

alt Sin permisos
  views --> http : Response 403 (Forbidden)
  deactivate views
  http --> api : Error
  deactivate http
  api --> ui : Error message
  deactivate api
  ui --> docente : Mostrar error
else Con permisos
  
  views -> fs : Eliminar archivo físico
  activate fs
  fs --> views : Archivo eliminado
  deactivate fs
  
  views -> models : recurso.delete()
  activate models
  models -> db : DELETE FROM recurso WHERE id = :id
  activate db
  db --> models : OK
  deactivate db
  models --> views : Eliminado
  deactivate models
  
  views --> http : Response 204 (No Content)
  deactivate views
  http --> api : Success
  deactivate http
  api --> ui : Recurso eliminado
  deactivate api
  
  ui -> ui : Remover recurso de la lista
  ui --> docente : Mostrar mensaje: "Recurso eliminado"
end

deactivate ui

== Error: Archivo No Encontrado ==

docente -> ui : Intenta descargar recurso
activate ui

ui -> http : GET /media/recursos/:path
activate http
http -> fs : Leer archivo
activate fs

alt Archivo no existe en filesystem
  fs --> http : FileNotFoundError
  deactivate fs
  http --> ui : Error 404
  deactivate http
  
  ui --> docente : Mostrar error:
  note right
    "El archivo no está disponible.
    Puede haber sido eliminado."
  end note
  
  ui -> api : reportMissingFile(recursoId)
  activate api
  note right
    Opcional: registrar inconsistencia
    entre DB y filesystem
  end note
  api --> ui : OK
  deactivate api
end

deactivate ui

@enduml
