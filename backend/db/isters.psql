-- ============================================================
-- RESUMEN ESTADISTICO
-- ============================================================
SELECT 
    'Bases de Datos' AS asignatura,
    COUNT(DISTINCT m.id_estudiante) AS estudiantes_matriculados,
    COUNT(na.id) AS notas_registradas,
    ROUND(AVG(na.nota_ra_actividad), 2) AS promedio_general
FROM asignatura a
LEFT JOIN matricula m ON a.id_asignatura = m.id_asignatura
LEFT JOIN notas_actividad na ON m.id_matricula = na.id_matricula
WHERE a.id_asignatura = 1
GROUP BY a.nombre;

SELECT 
    'Etica' AS asignatura,
    COUNT(DISTINCT m.id_estudiante) AS estudiantes_matriculados,
    COUNT(na.id) AS notas_registradas,
    ROUND(AVG(na.nota_ra_actividad), 2) AS promedio_general
FROM asignatura a
LEFT JOIN matricula m ON a.id_asignatura = m.id_asignatura
LEFT JOIN notas_actividad na ON m.id_matricula = na.id_matricula
WHERE a.id_asignatura = 2
GROUP BY a.nombre;

