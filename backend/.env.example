# Django Configuration
SECRET_KEY=tu-secret-key-aqui-generar-una-nueva
DEBUG=True

# Database Configuration
DB_NAME=ra_manager
DB_USER=postgres
DB_PASSWORD=tu-password-aqui
DB_HOST=localhost
DB_PORT=5432

# CORS Configuration (separar URLs con comas)
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend URL (para enlaces en emails)
FRONTEND_URL=http://localhost:5173

# Email Configuration
# Para desarrollo: django.core.mail.backends.console.EmailBackend (imprime en consola)
# Para producción: django.core.mail.backends.smtp.EmailBackend (envía emails reales)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu-email@gmail.com
EMAIL_HOST_PASSWORD=tu-app-password-aqui
DEFAULT_FROM_EMAIL=no-reply@univalle.edu.co

# Security Settings (Production Only)
# Descomenta y configura estas variables SOLO en producción
# SECURE_HSTS_SECONDS=31536000
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
