# ==================== CONFIGURACIÓN DE DJANGO ====================
# INSTRUCCIÓN: Copia este archivo como .env y configura tus valores
# Comando: cp .env.example .env (Linux/Mac) o copy .env.example .env (Windows)

SECRET_KEY=django-insecure-dev-key-CAMBIA-ESTO-POR-UNA-NUEVA-CLAVE
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ==================== CONFIGURACIÓN DE BASE DE DATOS ====================
# IMPORTANTE: Configura aquí TU base de datos PostgreSQL local
# Cada desarrollador debe usar su propia contraseña de PostgreSQL
DB_NAME=ra_manager
DB_USER=postgres
DB_PASSWORD=TU_PASSWORD_DE_POSTGRESQL_AQUI
DB_HOST=localhost
DB_PORT=5432

# ==================== CONFIGURACIÓN DE CORS ====================
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# ==================== CONFIGURACIÓN DE EMAIL ====================
# MODO DESARROLLO (Recomendado para pruebas locales)
# Los emails se imprimen en la consola del servidor, no se envían realmente
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@ramanager.local

# MODO PRODUCCIÓN (Envío real con Gmail)
# Para usar Gmail, necesitas crear una "Contraseña de aplicación":
# 1. Ve a https://myaccount.google.com/security
# 2. Activa "Verificación en dos pasos"
# 3. Busca "Contraseñas de aplicaciones" y genera una nueva
# 4. Usa esa contraseña (16 caracteres sin espacios) en EMAIL_HOST_PASSWORD
# 5. Descomenta las siguientes líneas:
#
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tu_correo@gmail.com
# EMAIL_HOST_PASSWORD=xxxxxxxxxxxxxxxxxxxx
# DEFAULT_FROM_EMAIL=tu_correo@gmail.com

# Configuración del sistema OTP (tiempo de expiración en minutos)
OTP_EXPIRY_MINUTES=5

# Contraseña provisional para cuentas creadas por carga masiva de estudiantes
# IMPORTANTE: cámbiala por una contraseña temporal institucional
DEFAULT_BULK_STUDENT_PASSWORD=estudiante123

# Habilitar envío de correos al importar estudiantes masivamente
SEND_WELCOME_EMAILS_ON_IMPORT=True

# ==================== CONFIGURACIÓN DE LOGGING ====================
DJANGO_LOG_LEVEL=INFO

# ==================== CONFIGURACIÓN DE SEGURIDAD (SOLO PRODUCCIÓN) ====================
# ⚠️ NO actives estas opciones en desarrollo local
# Descomenta SOLO cuando despliegues en producción con HTTPS
# SECURE_HSTS_SECONDS=31536000
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
